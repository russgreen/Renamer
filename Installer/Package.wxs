<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    The UpgradeCode MUST remain the same as the Advanced Installer based installers (Renamer.aip, up to and
    including 1.5.0) so that this package upgrades existing installations. The ProductCode is generated for every build.
  -->
  <Package Name="Renamer"
           Manufacturer="Russ Green"
           Version="$(var.ProductVersion)"
           UpgradeCode="9E39C5AA-EA69-45A7-A875-4F184F796F5F"
           Language="1033"
           Scope="perMachine">

    <SummaryInformation Description="Renamer installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="Renamer.ico" SourceFile="rg_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Renamer.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/russgreen/Renamer" />
    <Property Id="ARPCOMMENTS" Value="Renamer is a Revit add-in to batch rename elements using find/replace patterns, prefixes and suffixes." />

    <!-- Re-use the location of a previous installation (including those made by the Advanced Installer package) -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Russ Green\Renamer" Name="Path" Type="directory" Bitness="always64" />
    </Property>

    <!-- UI -->
    <WixVariable Id="WixUIBannerBmp" Value="renamer_banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="renamer_background.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Skip the license agreement and install folder pages: Welcome -> Ready to install -->
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="NOT Installed" />
    </UI>

    <!-- Install locations -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="RussGreenFolder" Name="Russ Green">
        <Directory Id="INSTALLFOLDER" Name="Renamer" />
      </Directory>

      <!-- Revit 2027 and later is installed under Program Files -->
      <Directory Id="PfAutodeskFolder" Name="Autodesk">
        <Directory Id="PfRevitFolder" Name="Revit">
          <Directory Id="PfRevitAddinsFolder" Name="Addins">
            <Directory Id="Revit2027Addins" Name="2027">
              <Directory Id="Revit2027App" Name="Renamer" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="RevitFolder" Name="Revit">
          <Directory Id="RevitAddinsFolder" Name="Addins">
            <?foreach Rel in 22;23;24;25;26?>
            <Directory Id="Revit20$(Rel)Addins" Name="20$(Rel)">
              <Directory Id="Revit20$(Rel)App" Name="Renamer" />
            </Directory>
            <?endforeach?>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Renamer" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppRegistry" />
      <ComponentGroupRef Id="RevitAddins" />
    </Feature>

    <ComponentGroup Id="AppRegistry" Directory="INSTALLFOLDER">
      <Component Id="ProductInformation">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\Russ Green\Renamer" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Russ Green\Renamer" Name="Version" Type="string" Value="[ProductVersion]" />
      </Component>
    </ComponentGroup>

    <!-- Revit add-ins, one set of files per supported Revit version -->
    <ComponentGroup Id="RevitAddins">
      <?foreach Rel in 22;23;24;25;26?>
      <ComponentGroupRef Id="Revit20$(Rel)" />
      <?endforeach?>
      <ComponentGroupRef Id="Revit2027" />
    </ComponentGroup>

    <?foreach Rel in 22;23;24;25;26?>
    <ComponentGroup Id="Revit20$(Rel)">
      <Component Id="Revit20$(Rel)Addin" Directory="Revit20$(Rel)Addins">
        <?if $(Rel) = 26?>
        <!-- Revit 2026 runs add-ins in an isolated load context -->
        <File Id="Revit20$(Rel)AddinFile" Name="Renamer.addin" Source="$(var.RepoRoot)\source\Renamer\Renamer_Isolated.addin" />
        <?else?>
        <File Id="Revit20$(Rel)AddinFile" Name="Renamer.addin" Source="$(var.RepoRoot)\source\Renamer\Renamer.addin" />
        <?endif?>
      </Component>
      <Files Include="$(var.RepoRoot)\source\Renamer\bin\Release R$(Rel)\**" Directory="Revit20$(Rel)App" />
    </ComponentGroup>
    <?endforeach?>

    <!-- Revit 2027 also runs add-ins in an isolated load context -->
    <ComponentGroup Id="Revit2027">
      <Component Id="Revit2027Addin" Directory="Revit2027Addins">
        <File Id="Revit2027AddinFile" Name="Renamer.addin" Source="$(var.RepoRoot)\source\Renamer\Renamer_Isolated.addin" />
      </Component>
      <Files Include="$(var.RepoRoot)\source\Renamer\bin\Release R27\**" Directory="Revit2027App" />
    </ComponentGroup>
  </Package>
</Wix>
